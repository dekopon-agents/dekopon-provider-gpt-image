# The one file in this example that references a secret — and it does not contain one.
#
#   cp broker-credentials.yaml.example broker-credentials.yaml
#   chmod 600 broker-credentials.yaml
#
# Stricter than broker.yaml on purpose: broker.yaml rejects group/world *writability*, while this
# file rejects group/world *anything* (mode & 0o077), because readability is the threat. It must also
# be a regular single-link file owned by the broker's UID.
#
# `kind: chatgptSubscription` lands in dekopon 0.13.0. Unlike `bearerToken` it carries no `secret`:
# the material lives in a Dekopon ChatGPT credential file that the broker opens through
# `read_trusted_file` (regular, owner-only, 0600, single link, O_NOFOLLOW) and refreshes in place. The
# broker injects two headers for the destinations below — `authorization: Bearer <access>` and
# `chatgpt-account-id`, the account id being a claim inside the access token the guest never sees —
# and audit records `credentialInjected: true` and this symbolic name, never a value.
#
# Create the file with a login of its own, never shared with the gateway's model credential:
#
#   dekopond auth chatgpt login --auth-file ~/.config/dekopon/chatgpt-auth.gpt-image.json
#
# Same ChatGPT account, independent refresh token: neither family can race the other's rotation and
# either can be revoked alone.
apiVersion: dekopon.dev/broker-credentials/v1alpha1
credentials:
  - name: chatgpt-gpt-image
    kind: chatgptSubscription
    authFile: /home/xavier/.config/dekopon/chatgpt-auth.gpt-image.json
    # Every `allowedHosts` entry in every constraint set binding this credential must appear here.
    destinations: [chatgpt.com]
